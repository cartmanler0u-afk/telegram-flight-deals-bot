# Token du bot, donné par @BotFather sur Telegram
TELEGRAM_BOT_TOKEN=

# ID du salon/canal Telegram où poster les drops (optionnel : peut aussi être
# défini plus tard avec la commande /setchannel envoyée dans le salon cible)
TELEGRAM_CHANNEL_ID=

# IDs Telegram (séparés par des virgules) des utilisateurs autorisés à utiliser
# les commandes d'administration (/addfeed, /addroute, /setchannel...).
# Laisser vide = aucune restriction (déconseillé si le bot est public).
ADMIN_USER_IDS=

# Fréquence de recherche de nouveaux bons plans, en minutes
CHECK_INTERVAL_MINUTES=30

# Clé API Kiwi Tequila (optionnelle). Sans elle, seule la source RSS est active.
KIWI_API_KEY=

# Connexion à votre projet Supabase (base PostgreSQL utilisée pour stocker les
# flux, routes et l'historique des bons plans déjà postés). Voir README.md.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
