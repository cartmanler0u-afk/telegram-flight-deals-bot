# Token du bot, donné par @BotFather sur Telegram
TELEGRAM_BOT_TOKEN=

# ID du salon/canal Telegram où poster les drops (optionnel : peut aussi être
# défini plus tard avec la commande /setchannel envoyée dans le salon cible)
TELEGRAM_CHANNEL_ID=

# IDs Telegram (séparés par des virgules) des utilisateurs autorisés à utiliser
# les commandes d'administration (/addfeed, /addroute, /setchannel...).
# Laisser vide = aucune restriction (déconseillé si le bot est public).
ADMIN_USER_IDS=

# Fréquence de recherche de nouveaux bons plans, en minutes
CHECK_INTERVAL_MINUTES=30

# Clé API Kiwi Tequila (optionnelle). Sans elle, seule la source RSS est active.
KIWI_API_KEY=

# Connexion à votre projet Supabase (base PostgreSQL utilisée pour stocker les
# flux, routes et l'historique des bons plans déjà postés). Voir README.md.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- QG des agents IA (mini app Telegram en 3D, commande /office) ---
# Adresse https publique où ce serveur est joignable (ex: https://mon-bot.up.railway.app).
# Telegram exige du https. Laisser vide tant que le bot n'est pas déployé.
WEBAPP_URL=
# Port HTTP du serveur de la mini app (les hébergeurs le fournissent souvent automatiquement)
PORT=3000
# Clé API Claude (optionnelle). Sans elle, les agents produisent des livrables à partir
# de modèles intégrés ; avec elle, ils travaillent réellement avec l'IA.
ANTHROPIC_API_KEY=
# Modèle utilisé par les agents (défaut : claude-opus-5-5). Ex : claude-sonnet-5-5, claude-haiku-5-5
ANTHROPIC_MODEL=claude-opus-5-5
# Effort de réflexion : low | medium | high
ANTHROPIC_EFFORT=medium
# Recherche web pour les dénicheurs de bons plans et le sourcing (mettre false pour la couper)
ANTHROPIC_WEB_SEARCH=true
# Mettre false pour couper les notifications Telegram du QG (rappels, dossiers à valider…)
OFFICE_NOTIFICATIONS=true

# --- THE MADHOUSE — Bâtiment 0 (simulation autonome autour du QG, commandes /building, /report…) ---
# Mettre false pour couper les notifications du Bâtiment (alertes rares + rapport du matin)
WORLD_NOTIFICATIONS=true
# IA narrative (courts récits des moments rares) : nécessite ANTHROPIC_API_KEY. false pour la couper.
WORLD_AI=true
# Plafond quotidien d'appels IA par bâtiment (aucun réglage en jeu ne peut le dépasser). 0 = aucun.
WORLD_AI_DAILY_CALLS=6
# Mode test du chaos (simuler une journée, déclencher un événement, rejouer avec une graine) :
# réservé au développement, et aux administrateurs (ADMIN_USER_IDS) même quand il est activé.
WORLD_DEV_TOOLS=false
